# Copy to .env and fill in.
DATABASE_URL=postgresql://tracker:tracker@localhost:5433/pricetracker

# Email alerts and daily report (Excel attached). Gmail: turn on 2-step verification, then create
# an app password at https://myaccount.google.com/apppasswords and paste it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Optional second channel. Telegram: create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PRICE_DROP_THRESHOLD_PCT=10

# "chrome" uses the Google Chrome installed on the machine; leave empty for Playwright's Chromium.
BROWSER_CHANNEL=

# Optional: comma-separated proxies, rotated per request. Leave empty to connect directly.
PROXY_LIST=

# Identify the bot honestly; put a contact URL or email.
USER_AGENT=Mozilla/5.0 (compatible; PriceTrackerBot/1.0; +https://github.com/MedAmine-SUDO/competitor-price-tracker)
